generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model exam_nodes {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  instructor_id    String
  parent_id        String?      @db.Uuid
  kind             String
  name             String
  sort_order       Int          @default(0)
  exam_id          String?      @db.Uuid
  created_at       DateTime?    @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?    @default(now()) @db.Timestamptz(6)
  exams            exams?       @relation(fields: [exam_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  color            String? // 노드 색상 (UI 표시용)
  exam_nodes       exam_nodes?  @relation("exam_nodesToexam_nodes", fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  other_exam_nodes exam_nodes[] @relation("exam_nodesToexam_nodes")

  @@index([exam_id], map: "idx_exam_nodes_exam_id")
  @@index([instructor_id], map: "idx_exam_nodes_instructor_id")
  @@index([kind], map: "idx_exam_nodes_kind")
  @@index([parent_id], map: "idx_exam_nodes_parent_id")
  @@index([parent_id, sort_order], map: "idx_exam_nodes_sort_order")
  @@index([instructor_id, parent_id], map: "idx_exam_nodes_instructor_parent")
  @@index([updated_at], map: "idx_exam_nodes_updated_at")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model exams {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                  String
  code                   String                 @unique
  description            String?
  duration               Int
  questions              Json
  status                 String?                @default("draft")
  instructor_id          String
  student_count          Int?                   @default(0)
  created_at             DateTime?              @default(now()) @db.Timestamptz(6)
  updated_at             DateTime?              @default(now()) @db.Timestamptz(6)
  materials              Json?                  @default("[]")
  rubric                 Json?                  @default("[]")
  // Gate 방식 필드 추가
  open_at                DateTime?              @db.Timestamptz(6) // 입장 시작 시간 (Access Window 시작)
  close_at               DateTime?              @db.Timestamptz(6) // 입장 마감 시간 (Join cutoff)
  started_at             DateTime?              @db.Timestamptz(6) // Gate Start 신호 시간 (교수 Start Exam 클릭 시)
  allow_draft_in_waiting Boolean?               @default(false) // Waiting Room에서 Drafting 허용 여부
  allow_chat_in_waiting  Boolean?               @default(false) // Waiting Room에서 AI Chat 허용 여부
  chat_weight            Int?                   @default(50) // 채팅 단계 가중치 (0-100), answer_weight = 100 - chat_weight
  score_weights          Json? // 최종 점수 유형별 비중 정책 (MCQ/OX/Case)
  rubric_public          Boolean?               @default(false) // 루브릭 공개 여부
  materials_text         Json?                  @default("[]") // 추출된 텍스트 저장
  rag_status             String?                @default("none") // 'none' | 'pending' | 'processing' | 'completed' | 'failed'
  type                   String?                @default("exam") // 'exam' | 'report' | 'code' | 'erd' | 'mindmap'
  deadline               DateTime?              @db.Timestamptz(6) // 과제 제출 기한
  assignment_prompt      String? // 과제 설명/프롬프트
  initial_state          Json?                  @default("{}") // Instructor template: starter code, initial ERD, etc.
  canvas_config          Json?                  @default("{}") // Canvas config: { secondaryCanvas, layout, codeEnabled, erdEnabled }
  grades_released        Boolean?               @default(false) // 성적 공개 여부 (채점 확정)
  language               String                 @default("ko") // AI 시스템 프롬프트 언어 (ko | en)
  is_demo                Boolean                @default(false) // 데모 시험: 목록·통계·발행 카운트에서 제외 (#80)
  first_published_at     DateTime?              @db.Timestamptz(6) // 첫 학생 세션 생성 시 COALESCE 기록 (#84)
  ai_events              ai_events[]
  exam_grading_sessions  exam_grading_sessions[]
  exam_nodes             exam_nodes[]
  exam_material_chunks   exam_material_chunks[]
  onboarding_events      onboarding_events[]
  question_records       questions[]
  session_quiz_attempts  session_quiz_attempts[]
  sessions               sessions[]

  @@index([code], map: "idx_exams_code")
  @@index([instructor_id], map: "idx_exams_instructor_id")
  @@index([rubric], map: "idx_exams_rubric", type: Gin)
  @@index([open_at], map: "idx_exams_open_at")
  @@index([close_at], map: "idx_exams_close_at")
  @@index([status], map: "idx_exams_status")
  @@index([type], map: "idx_exams_type")
  @@index([instructor_id, is_demo], map: "idx_exams_instructor_demo")
  @@index([instructor_id, first_published_at], map: "idx_exams_instructor_first_published")
}

model plan_limits {
  plan               String   @id
  max_publishes      Int? // null = 무제한
  max_students       Int? // null = 무제한
  ai_demo_generation Boolean  @default(false)
  updated_at         DateTime @default(now()) @db.Timestamptz(6)

  @@map("plan_limits")
}

/// 온보딩 액티베이션 퍼널 마일스톤. UNIQUE(user_id, event)로 "최초 도달" 의미론을 강제한다.
model onboarding_events {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String
  role        String
  event       String
  exam_id     String?  @db.Uuid
  exams       exams?   @relation(fields: [exam_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  metadata    Json     @default("{}")
  occurred_at DateTime @default(now()) @db.Timestamptz(6)

  @@unique([user_id, event])
  @@index([event, occurred_at(sort: Desc)], map: "idx_onboarding_events_event_occurred")
  @@map("onboarding_events")
}

model grades {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id    String   @db.Uuid
  q_idx         Int
  score         Int
  comment       String?
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  stage_grading Json?
  grade_type    String   @default("manual") // "auto" | "manual"
  ai_summary    Json?
  sessions      sessions @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([session_id, q_idx])
  @@index([session_id], map: "idx_grades_session_id")
  @@index([session_id, q_idx], map: "idx_grades_session_qidx")
  @@index([grade_type], map: "idx_grades_grade_type")
}

/// Instructor–AI chat during case-question grading (per session + q_idx)
model grading_chats {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id        String   @db.Uuid
  q_idx             Int
  role              String
  content           String
  created_by        String?
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  client_message_id String?  @db.Uuid
  sessions          sessions @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([session_id, q_idx, created_at], map: "idx_grading_chats_session_q_idx_created")
}

/// AI 설정 버전 — 불변. 저장할 때마다 새 행이 생기고 기존 행은 수정되지 않는다.
/// profiles 는 sparse override 만 담는다(코드/env 기본값을 물질화하지 않는다). 이슈 #118.
model ai_config_versions {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profiles       Json
  created_by     String
  created_at     DateTime           @default(now()) @db.Timestamptz(6)
  labels         ai_config_labels[]
  audit_previous ai_config_audit[]  @relation("ai_config_audit_previous_version")
  audit_new      ai_config_audit[]  @relation("ai_config_audit_new_version")

  @@index([created_at(sort: Desc)], map: "idx_ai_config_versions_created_at")
}

/// 이동 가능한 라벨. `production` 하나가 현재 적용 버전을 가리킨다.
/// 롤백 = 라벨을 이전 버전으로 옮기기(버전 행은 그대로 남는다). 이슈 #118.
model ai_config_labels {
  label      String             @id
  version_id String             @db.Uuid
  updated_at DateTime           @default(now()) @db.Timestamptz(6)
  version    ai_config_versions @relation(fields: [version_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([version_id], map: "idx_ai_config_labels_version")
}

/// 설정 변경 감사 로그 — append-only. 누가·언제·무엇을·왜 바꿨는지 남긴다. 이슈 #118.
model ai_config_audit {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor               String
  action              String
  previous_version_id String?             @db.Uuid
  new_version_id      String              @db.Uuid
  reason              String
  created_at          DateTime            @default(now()) @db.Timestamptz(6)
  previous_version    ai_config_versions? @relation("ai_config_audit_previous_version", fields: [previous_version_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  new_version         ai_config_versions  @relation("ai_config_audit_new_version", fields: [new_version_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([created_at(sort: Desc)], map: "idx_ai_config_audit_created_at")
  @@index([new_version_id], map: "idx_ai_config_audit_new_version")
}

model ai_events {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider                  String
  endpoint                  String
  feature                   String
  route                     String
  model                     String
  user_id                   String?
  exam_id                   String?   @db.Uuid
  session_id                String?   @db.Uuid
  q_idx                     Int?
  status                    String
  attempt_count             Int       @default(1)
  latency_ms                Int?
  input_tokens              Int?
  output_tokens             Int?
  cached_input_tokens       Int?
  reasoning_tokens          Int?
  total_tokens              Int?
  estimated_cost_usd_micros BigInt    @default(0)
  pricing_version           String
  request_id                String?
  response_id               String?
  error_code                String?
  metadata                  Json      @default("{}")
  created_at                DateTime  @default(now()) @db.Timestamptz(6)
  config_version            String?   @db.Uuid
  exams                     exams?    @relation(fields: [exam_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  sessions                  sessions? @relation(fields: [session_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([created_at(sort: Desc)], map: "idx_ai_events_created_at")
  @@index([feature, created_at(sort: Desc)], map: "idx_ai_events_feature_created_at")
  @@index([model, created_at(sort: Desc)], map: "idx_ai_events_model_created_at")
  @@index([exam_id, created_at(sort: Desc)], map: "idx_ai_events_exam_created_at")
  @@index([session_id], map: "idx_ai_events_session_id")
  @@index([user_id, created_at(sort: Desc)], map: "idx_ai_events_user_created_at")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model messages {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id           String   @db.Uuid
  q_idx                Int
  role                 String
  content              String
  created_at           DateTime @default(now()) @db.Timestamptz(6)
  compressed_content   String?
  compression_metadata Json?    @default("{}")
  response_id          String? // OpenAI Responses API response ID for chaining conversations
  message_type         String? // 질문 타입: "concept" | "calculation" | "strategy" | "other"
  tokens_used          Int? // 토큰 사용량 (prompt + completion)
  metadata             Json?    @default("{}") // 추가 메타데이터 (토큰 상세 정보 등)
  sessions             sessions @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([session_id], map: "idx_messages_session_id")
  @@index([session_id, q_idx], map: "idx_messages_session_qidx")
  @@index([session_id, q_idx, created_at(sort: Desc)], map: "idx_messages_session_qidx_created")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model questions {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exam_id    String   @db.Uuid
  idx        Int
  type       String
  prompt     String
  ai_context String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  exams      exams    @relation(fields: [exam_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([exam_id], map: "idx_questions_exam_id")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model sessions {
  id                       String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exam_id                  String        @db.Uuid
  student_id               String
  used_clarifications      Int           @default(0)
  created_at               DateTime      @default(now()) @db.Timestamptz(6)
  submitted_at             DateTime?     @db.Timestamptz(6)
  compressed_session_data  String?
  compression_metadata     Json?         @default("{}")
  ai_summary               Json? // AI 자동 채점 요약 평가
  grading_progress         Json? // 채점 진행률 ({ status, total, completed, failed, updated_at })
  // Gate 방식 필드 추가
  status                   String?       @default("not_joined") // "not_joined" | "joined" | "waiting" | "in_progress" | "submitted" | "auto_submitted" | "locked"
  started_at               DateTime?     @db.Timestamptz(6) // Gate Start 신호 수신 시간 (InProgress 전환 시)
  attempt_timer_started_at DateTime?     @db.Timestamptz(6) // 개별 타이머 시작 시간
  auto_submitted           Boolean?      @default(false) // 자동 제출 플래그
  preflight_accepted_at    DateTime?     @db.Timestamptz(6) // Preflight Modal 수락 시간
  late_entry_approved_at   DateTime?     @db.Timestamptz(6) // 지각 입장 승인 시간
  late_entry_denied_at     DateTime?     @db.Timestamptz(6) // 지각 입장 거부 시간
  is_active                Boolean?      @default(true) // 세션 활성 상태
  last_heartbeat_at        DateTime?     @db.Timestamptz(6) // 마지막 heartbeat 시간
  device_fingerprint       String? // 디바이스 식별용 핑거프린트
  final_answer             String? // 과제 최종답안 (학생이 리서치 후 제출 전 작성하는 정리)
  final_answer_updated_at  DateTime?     @db.Timestamptz(6) // 최종답안 마지막 수정 시간
  exams                    exams         @relation(fields: [exam_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ai_events                ai_events[]
  grades                   grades[]
  grading_chats            grading_chats[]
  messages                 messages[]
  session_quiz_attempts    session_quiz_attempts[]
  submissions              submissions[]

  @@unique([exam_id, student_id])
  @@index([exam_id], map: "idx_sessions_exam_id")
  @@index([student_id], map: "idx_sessions_student_id")
  @@index([exam_id, student_id], map: "idx_sessions_exam_student")
  @@index([student_id, created_at], map: "idx_sessions_student_created")
  @@index([exam_id, submitted_at], map: "idx_sessions_exam_submitted")
  @@index([status], map: "idx_sessions_status")
  @@index([exam_id, status], map: "idx_sessions_exam_status")
  @@index([is_active, last_heartbeat_at], map: "idx_sessions_active_heartbeat")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model submissions {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id             String    @db.Uuid
  q_idx                  Int
  answer                 String
  created_at             DateTime  @default(now()) @db.Timestamptz(6)
  updated_at             DateTime? @default(now()) @db.Timestamptz(6) // 답안 수정 시간
  answer_history         Json?     @default("[]") // 답안 수정 이력: [{ text: string, timestamp: string }]
  edit_count             Int?      @default(0) // 답안 수정 횟수
  compressed_answer_data String?
  compression_metadata   Json?     @default("{}")
  workspace_state        Json?     @default("{}") // Student's combined workspace: { code, erd, notes }
  sessions               sessions  @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([session_id, q_idx])
  @@index([session_id], map: "idx_submissions_session_id")
  @@index([session_id, q_idx], map: "idx_submissions_session_qidx")
}

model session_quiz_attempts {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id         String    @db.Uuid
  exam_id            String    @db.Uuid
  student_id         String
  questions          Json
  answers            Json?     @default("{}")
  score              Int?
  total_questions    Int       @default(0)
  time_limit_seconds Int       @default(15)
  started_at         DateTime? @db.Timestamptz(6)
  submitted_at       DateTime? @db.Timestamptz(6)
  status             String    @default("pending") // "pending" | "in_progress" | "submitted"
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime? @default(now()) @db.Timestamptz(6)
  exams              exams     @relation(fields: [exam_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sessions           sessions  @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([session_id])
  @@index([exam_id], map: "idx_session_quiz_attempts_exam_id")
  @@index([student_id], map: "idx_session_quiz_attempts_student_id")
  @@index([status], map: "idx_session_quiz_attempts_status")
}

/// Student profile information
model student_profiles {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id     String   @unique // Clerk user ID
  name           String // 학생 이름
  student_number String // 학번
  school         String // 학교명
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @db.Timestamptz(6)

  @@index([student_id], map: "idx_student_profiles_student_id")
}

/// 강사용 AI 에이전트 런 영속화 (exam_creation 등)
/// steps/input/output 은 JSON 컬럼. last_response_id/pending_tool_calls 는 러너 내부용.
model agent_runs {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type               String
  actor_id           String
  actor_role         String
  status             String
  title              String?
  input              Json
  steps              Json      @default("[]")
  output             Json?
  exam_id            String?   @db.Uuid
  last_response_id   String? // 러너 내부용 — OpenAI Responses API 체이닝
  pending_tool_calls Json? // 러너 내부용 — 실행 대기 중인 function call
  cancel_requested   Boolean   @default(false) // 협조적 취소 플래그 — 러너가 루프 중 확인
  error              String?
  tokens_used        Int       @default(0)
  cost_usd_micros    BigInt    @default(0)
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime  @updatedAt @db.Timestamptz(6)
  completed_at       DateTime? @db.Timestamptz(6)

  @@index([actor_id], map: "idx_agent_runs_actor_id")
  @@index([status], map: "idx_agent_runs_status")
  @@index([created_at], map: "idx_agent_runs_created_at")
  @@map("agent_runs")
}

/// RAG: 시험 자료 청크 및 벡터 임베딩 저장
model exam_material_chunks {
  id         String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exam_id    String                       @db.Uuid
  file_url   String
  content    String                       @db.Text
  embedding  Unsupported("vector(1536)")? // pgvector 확장 사용
  metadata   Json?                        @default("{}")
  created_at DateTime                     @default(now()) @db.Timestamptz(6)
  exams      exams                        @relation(fields: [exam_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([exam_id], map: "idx_exam_material_chunks_exam_id")
  @@index([file_url], map: "idx_exam_material_chunks_file_url")
  @@map("exam_material_chunks")
}

/// AI 일괄 채점 세션 (exam_id + instructor_id 당 하나)
model exam_grading_sessions {
  id                             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exam_id                        String                  @db.Uuid
  instructor_id                  String
  proposed_grades                Json                    @default("{}")
  status                         String                  @default("draft")
  committed_at                   DateTime?               @db.Timestamptz(6)
  created_at                     DateTime                @default(now()) @db.Timestamptz(6)
  updated_at                     DateTime                @default(now()) @db.Timestamptz(6)
  grading_criteria               String?
  grading_total                  Int                     @default(0)
  grading_completed              Int                     @default(0)
  grading_failed_count           Int                     @default(0)
  expected_session_ids           Json                    @default("[]")
  calibration_sample_session_ids Json                    @default("[]")
  calibration_sample_grades      Json                    @default("{}")
  calibration_status             String                  @default("draft")
  grading_scope                  String                  @default("full")
  calibration_attempt            Int                     @default(0)
  current_attempt_id             String?
  processed_session_ids          Json                    @default("{}")
  ai_config_version_id           String?                 @db.Uuid
  ai_profile_snapshot            Json?
  exams                          exams                   @relation(fields: [exam_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  bulk_grading_messages          bulk_grading_messages[]

  @@unique([exam_id, instructor_id], map: "exam_grading_sessions_exam_instructor_key")
  @@index([exam_id], map: "idx_exam_grading_sessions_exam_id")
}

/// AI 일괄 채점 대화 메시지 (row-per-message, race condition 방지)
model bulk_grading_messages {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id        String                @db.Uuid
  role              String
  content           String
  created_by        String?
  created_at        DateTime              @default(now()) @db.Timestamptz(6)
  client_message_id String?               @db.Uuid
  exam_grading_sessions exam_grading_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([session_id, created_at], map: "idx_bulk_grading_messages_session_created")
}
/// 025: 개인정보 동의 원장. append-only — UPDATE 는 DB trigger 가 거부하고
/// DELETE 는 purge_expired_consent_records RPC 경로만 허용한다.
/// user_id 를 저장하지 않는다. 식별은 consent_subject_map 이 담당한다.
/// This model contains row level security and requires additional setup for migrations.
model consent_records {
  id                      String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subject_ref             String
  controller_type         String                  @default("platform")
  consent_key             String
  granted                 Boolean
  policy_version          String
  recorded_at             DateTime                @default(now()) @db.Timestamptz(6)
  consent_policy_releases consent_policy_releases @relation(fields: [policy_version], references: [release_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([subject_ref, consent_key, recorded_at(sort: Desc)], map: "idx_consent_records_subject_key_recorded")
  @@index([subject_ref], map: "idx_consent_records_subject_ref")
}

/// 025: 식별 매핑. 탈퇴 = 이 테이블 1행 DELETE.
/// service_role 직접 권한은 회수됐고 register_consent_subject RPC 로만 쓴다.
/// This model contains row level security and requires additional setup for migrations.
model consent_subject_map {
  user_id     String   @id
  subject_ref String   @unique
  created_at  DateTime @default(now()) @db.Timestamptz(6)
}

/// 025: 불변 정책 릴리스. UPDATE/DELETE 를 trigger 가 거부한다.
/// 최초 행은 027_seed_consent_policy_release.sql 이 소유한다.
/// This model contains row level security and requires additional setup for migrations.
model consent_policy_releases {
  release_id         String            @id
  content_hash       String            @db.Char(64)
  effective_at       DateTime          @unique @db.Timestamptz(6)
  requires_reconsent Boolean
  created_at         DateTime          @default(now()) @db.Timestamptz(6)
  consent_records    consent_records[]

  @@index([effective_at(sort: Desc)], map: "idx_consent_policy_releases_effective")
}

/// 025: 탈퇴 후 3년 보존 기한. destroy_after 는 CHECK 로 DB 가 강제한다.
/// This table contains check constraints and requires additional setup for migrations.
/// This model contains row level security and requires additional setup for migrations.
model consent_retention_index {
  subject_ref   String   @id
  deleted_at    DateTime @db.Timestamptz(6)
  destroy_after DateTime @db.Timestamptz(6)

  @@index([destroy_after], map: "idx_consent_retention_index_destroy_after")
}

/// 025: 파기 배치 실행 로그. 원·가명 user_id 를 기록하지 않는다.
/// This table contains check constraints and requires additional setup for migrations.
/// This model contains row level security and requires additional setup for migrations.
model consent_purge_runs {
  run_id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  job             String
  started_at      DateTime  @default(now()) @db.Timestamptz(6)
  finished_at     DateTime? @db.Timestamptz(6)
  cutoff          DateTime? @db.Timestamptz(6)
  candidate_count Int       @default(0)
  deleted_count   Int       @default(0)
  status          String
  error           String?
}
