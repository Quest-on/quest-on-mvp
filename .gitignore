# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
exports/
*_export.csv
/scripts/export-sessions.ts

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 값이 없는 템플릿은 커밋한다 (환경 매니페스트의 사람이 읽는 사본)
!.env.example
!.env.staging.example

# vercel
.vercel

# MCP config (contains project refs)
.mcp.json

# supabase local
supabase/.branches/
supabase/.temp/

# npm cache
.npm-cache

# typescript
*.tsbuildinfo
next-env.d.ts

#sql
*.sql
# SQL files in database directory (can be committed if needed)
!database/*.sql

# impact-review per-run agent brief artifact (best-effort cleanup; guard against commit)
.impact-review-brief.*.json
# 에이전트 런타임 상태 (기기별, 버전관리 대상 아님)
.gjc/
**/.gjc/
.orca/
**/.orca/
