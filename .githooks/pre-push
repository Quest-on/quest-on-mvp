#!/bin/sh
# 보호 브랜치(main, staging)로 직접 push 차단 (메인테이너 제외).
DIR="$(dirname "$0")"
. "$DIR/_lib.sh"

if is_maintainer; then
  exit 0
fi

# stdin 형식: <local ref> <local sha> <remote ref> <remote sha>
blocked=""
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/*)
      _branch="${remote_ref#refs/heads/}"
      if is_protected_branch "$_branch"; then
        blocked="$_branch"
      fi
      ;;
  esac
done

if [ -n "$blocked" ]; then
  echo ""
  echo "⛔  $blocked 브랜치로 직접 push 할 수 없습니다."
  echo ""
  echo "    작업 브랜치로 push 하고 Pull Request 를 올리세요:"
  echo ""
  echo "        git push -u origin feat/내작업이름"
  echo ""
  echo "    (자세한 내용: CONTRIBUTING.md)"
  echo ""
  exit 1
fi

exit 0
