# 로컬 개발용 템플릿. 실제 값을 채워 .env.local 로 복사한다.
# 환경별 필수 여부의 SSOT 는 lib/env-manifest.ts — 이 파일은 사람이 읽는 사본이다.
# 검증: npm run env:check -- --file .env.local --env development

# --- 런타임 환경 ---
# development | test | staging | production (미설정 시 VERCEL_ENV → NODE_ENV 순으로 추론)
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (DB + Auth) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --- 개인정보 동의 ---
# 동의 원장의 subject_ref 파생 키 (base64, 32바이트 이상).
# 원장은 user_id 대신 HMAC 값만 저장하므로 이 키가 재식별의 유일한 경로다.
# 분실 시 기존 원장의 재식별이 영구 불가. escrow 와 복구 리허설 필수.
# 생성: openssl rand -base64 32
CONSENT_SUBJECT_HMAC_KEY_V1=

# --- OpenAI ---
OPENAI_API_KEY=
# 선택: 모델 오버라이드
# AI_MODEL=
# AI_MODEL_HEAVY=

# --- 관리자 콘솔 ---
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# --- 내부 호출 / 백그라운드 ---
INTERNAL_API_SECRET=
CRON_SECRET=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# QSTASH_WORKER_BASE_URL=

# --- 레이트리밋 / 캐시 ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- CORS (미설정 시 코드의 기본 목록) ---
# ALLOWED_ORIGINS=http://localhost:3000

# --- E2E 전용. 프로덕션에는 절대 넣지 않는다 ---
# TEST_BYPASS_SECRET=
# NEXT_PUBLIC_TEST_BYPASS_ENABLED=true

# Instructor memory emergency switches (only the exact value 1 changes boolean defaults)
MEMORY_EXTRACTION_DISABLED=
MEMORY_STORAGE_DISABLED=
MEMORY_SELECTION_DISABLED=
MEMORY_RENDERING_DISABLED=
MEMORY_INJECTION_ENABLED=
MEMORY_SCORE_PATH_INJECTION_ENABLED=
MEMORY_QUARANTINED_EXTRACTOR_VERSION=
