# 스테이징(별도 Vercel 프로젝트) 환경변수 템플릿.
# 절차와 배경은 docs/STAGING.md. 검증: npm run env:check -- --file .env.staging --env staging
#
# 원칙 1: 프로덕션 자원을 하나도 공유하지 않는다.
#   Supabase 프로젝트 / Upstash DB / 관리자 비밀번호 / OpenAI 키 전부 별도.
#   QStash 는 계정 단위 서명키라 공유되지만, 콜백 URL 이 스테이징 도메인으로 분리된다.
# 원칙 2: 인증 경로는 프로덕션과 100% 동일하다.
#   외부 QA 참여자가 실제 도메인으로 들어오므로 테스트 바이패스 키를 넣지 않는다.
#   넣으면 요청 처리 중 즉시 throw 한다 (lib/supabase-auth.ts).
# 원칙 3: 프로덕션 데이터를 복사하지 않는다. 시드 데이터로 채운다.

# --- 런타임 환경 ---
# 스테이징을 별도 Vercel 프로젝트로 두면 VERCEL_ENV=production 이 되므로 이 값이 필수다.
NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_APP_URL=https://staging.quest-on.app

# --- Supabase (스테이징 전용 프로젝트) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --- 개인정보 동의 ---
# 프로덕션과 반드시 다른 키를 쓴다. 같은 키를 쓰면 스테이징에서
# 프로덕션 사용자의 subject_ref 를 역산할 수 있다.
# 생성: openssl rand -base64 32
CONSENT_SUBJECT_HMAC_KEY_V1=
# off | shadow | prompt | enforce. 배포 환경에서는 반드시 명시한다.
CONSENT_GATE_MODE=shadow
# 최초 배포는 비활성 dry-run. 삭제 모드 활성화는 staging 증적 + 별도 운영 승인 receipt 후에만.
CONSENT_RETENTION_PURGE_DISABLED=1
CONSENT_RETENTION_PURGE_MODE=dry-run
# 승인된 operator 환경 전용(consent_auditor). Vercel 런타임에 넣지 않는다.
# CONSENT_AUDIT_DATABASE_URL=

# --- OpenAI (예산 한도 건 별도 키 권장) ---
OPENAI_API_KEY=

# --- 관리자 콘솔 (프로덕션과 다른 비밀번호) ---
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# --- 내부 호출 / 백그라운드 ---
INTERNAL_API_SECRET=
CRON_SECRET=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_WORKER_BASE_URL=https://staging.quest-on.app

# --- 레이트리밋 / 캐시 (스테이징 전용 Upstash DB) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- CORS: 스테이징 도메인을 명시하지 않으면 프로덕션 기본 목록이 적용돼 전부 차단된다 ---
ALLOWED_ORIGINS=https://staging.quest-on.app

# --- 여기에 TEST_BYPASS_SECRET / NEXT_PUBLIC_TEST_BYPASS_ENABLED 를 넣지 않는다 ---
# 스테이징은 프로덕션과 동일한 Supabase Auth 로그인으로만 들어간다.
# E2E 바이패스는 로컬(development)과 CI(test)에서만 동작한다.
